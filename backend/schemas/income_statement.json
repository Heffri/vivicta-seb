      "excludes": [
        "other operating income",
        "other income",
        "övriga rörelseintäkter"
      ],
      "label": "Revenue",
      "description": "Net sales / revenue from contracts with customers for the group. If sales are split into lines of the same kind (e.g. 'Sales' + 'Sales, acquired business' = 'Total sales'), take the total. Not a 'Revenue'/'Total revenue' subtotal that adds other operating income to net sales (then take 'Net sales').",
