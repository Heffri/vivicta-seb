  "checks": [
    {
      "name": "gross_profit_arith",
      "expr": "abs((revenue + cost_of_sales) - gross_profit) <= 2",
      "detail": "revenue + cost_of_sales == gross_profit (±2 rounding)",
      "identity": true
    },
    {
      "name": "net_profit_arith",
      "expr": "abs((profit_before_tax + income_tax + profit_discontinued) - net_profit) <= 2",
      "detail": "profit_before_tax + income_tax (+ discontinued operations) == net_profit (±2 rounding)",
      "identity": true
    },
    {
      "name": "margin_sanity",
      "expr": "-10 < operating_profit / revenue < 10",
      "detail": "operating profit within 10x revenue (a unit mix-up is 1000x; Nordnet's 69% margin and Vitrolife's impairment year are real)"
    }
  ]
}
