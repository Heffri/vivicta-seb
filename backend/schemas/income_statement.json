  "checks": [
    {
      "name": "gross_profit_arith",
      "expr": "abs((revenue + cost_of_sales) - gross_profit) <= 2",
      "detail": "revenue + cost_of_sales == gross_profit (±2 rounding)"
    },
    {
      "name": "net_profit_arith",
      "expr": "abs((profit_before_tax + income_tax) - net_profit) <= 2",
      "detail": "profit_before_tax + income_tax == net_profit (±2 rounding)"
    },
    {
      "name": "margin_sanity",
      "expr": "0 < operating_profit / revenue < 0.6",
      "detail": "operating margin between 0 and 60%"
    }
  ]
}
