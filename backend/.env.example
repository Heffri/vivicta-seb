# Copy to backend/.env. All three unset => backend returns fixtures/sample_extraction.json (frontend dev mode).
# Same variables point at Azure OpenAI / OpenAI / OpenRouter with no code change.

# LLM_BASE_URL=http://localhost:11434/v1   # Ollama (OpenAI-compatible)
# LLM_MODEL=qwen3:8b
# LLM_API_KEY=ollama                       # any non-empty string for Ollama
# EMBED_MODEL=bge-m3                       # embeddings via the same base URL (/v1/embeddings); multilingual sv+en. `ollama pull bge-m3`
# FEWSHOT=2                                # prior checks-passed extractions of the same section shown to the model as examples; 0 disables
# KB_DIR=../data/kb                        # knowledge base on disk, relative to backend/
# LLM_TIMEOUT=300                          # seconds per model call; on timeout the call is retried once on the two statement pages only

# Demo with your existing `codex login` (no API key required for extraction/Ask):
# LLM_PROVIDER=codex
# LLM_MODEL=gpt-5.6-terra
# LLM_REASONING=low
# CODEX_BIN=codex                         # executable path if not on PATH
# EMBED_BASE_URL=http://localhost:11434/v1
# EMBED_API_KEY=ollama
# EMBED_MODEL=bge-m3
# EMBED_TIMEOUT=120
# LLM_PROVIDER=fixture                   # explicit UI development mode
